APP_NAME=AI Cybersecurity Mentor
APP_ENV=development
# Use DEBUG=false outside local development (DEBUG only controls log verbosity).
DEBUG=true

API_V1_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_cybersec_mentor

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini AI engine (Step 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=60

# --- Voice & Speaking Analysis (Step 8) ---
# Speech-to-text runs locally with faster-whisper (no audio leaves your machine).
# Model size: tiny | base | small | medium | large-v3 ...  (bigger = slower, more accurate)
WHISPER_MODEL=small
# auto | cpu | cuda      (auto uses a GPU if one is available, otherwise CPU)
WHISPER_DEVICE=auto
# auto | int8 | float16 | float32   (int8 is a good CPU choice)
WHISPER_COMPUTE_TYPE=auto
# Language the recogniser is pinned to. Empty = auto-detect per recording.
WHISPER_LANGUAGE=en

# Audio upload limits
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_AUDIO_SECONDS=300
# Temporary audio location while transcribing (empty = OS temp dir)
VOICE_TEMP_DIR=

# Text-to-speech (optional). Leave TTS_PROVIDER empty to disable spoken replies.
# Supported providers: openai | google
TTS_PROVIDER=
TTS_API_KEY=
# openai: e.g. tts-1 (default)        google: not used
TTS_MODEL=
# openai: e.g. alloy (default)        google: e.g. en-US-Neural2-F
TTS_VOICE=
# Optional: OpenAI-compatible endpoint (e.g. a self-hosted TTS server)
TTS_BASE_URL=

# Comma-separated filler-word override (empty = built-in list)
FILLER_WORDS=

